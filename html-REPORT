public class ValidationError {

    private String applicationName;

    private String path;

    private String message;

    private String invalidValue;

    public ValidationError(
            String applicationName,
            String path,
            String message,
            String invalidValue) {

        this.applicationName = applicationName;
        this.path = path;
        this.message = message;
        this.invalidValue = invalidValue;
    }

    public String getApplicationName() {
        return applicationName;
    }

    public String getPath() {
        return path;
    }

    public String getMessage() {
        return message;
    }

    public String getInvalidValue() {
        return invalidValue;
    }
}



import java.util.ArrayList;
import java.util.List;

public class ValidationContext {

    private final List<ValidationError> errors =
            new ArrayList<>();

    public void addError(
            ValidationError error) {

        errors.add(error);
    }

    public boolean hasErrors() {

        return !errors.isEmpty();
    }

    public List<ValidationError> getErrors() {

        return errors;
    }
}



      import com.fasterxml.jackson.databind.JsonNode;
import com.networknt.schema.*;

import java.util.Set;

public class RootYamlValidator {

    public void validate(
            JsonNode yamlNode,
            String schemaName,
            String applicationName,
            ValidationContext context)
            throws Exception {

        JsonNode schemaNode =
                SchemaLoader.loadSchema(schemaName);

        JsonSchemaFactory factory =
                JsonSchemaFactory.getInstance(
                        SpecVersion.VersionFlag.V7);

        JsonSchema schema =
                factory.getSchema(schemaNode);

        Set<ValidationMessage> messages =
                schema.validate(yamlNode);

        for (ValidationMessage msg : messages) {

            context.addError(
                    new ValidationError(
                            applicationName,
                            msg.getPath(),
                            msg.getMessage(),
                            "INVALID"));
        }
    }
}



import com.fasterxml.jackson.databind.JsonNode;

import java.util.Iterator;

public class ApplicationSchemaRouter {

    private final RootYamlValidator validator =
            new RootYamlValidator();

    public void validateApplications(
            JsonNode root,
            ValidationContext context)
            throws Exception {

        JsonNode entities =
                root.get("entities");

        for (JsonNode entity : entities) {

            JsonNode applications =
                    entity.get("applications");

            for (JsonNode appNode : applications) {

                try {

                    String applicationName =
                            appNode.get("application")
                                   .asText();

                    Iterator<String> fields =
                            appNode.fieldNames();

                    while (fields.hasNext()) {

                        String field =
                                fields.next();

                        if ("application"
                                .equals(field)) {

                            continue;
                        }

                        JsonNode actualData =
                                appNode.get(field);

                        validateByApplication(
                                applicationName,
                                actualData,
                                context);
                    }

                } catch (Exception ex) {

                    context.addError(
                            new ValidationError(
                                    "SYSTEM",
                                    "$.applications",
                                    ex.getMessage(),
                                    "APPLICATION_ERROR"));
                }
            }
        }
    }

    private void validateByApplication(
            String applicationName,
            JsonNode actualData,
            ValidationContext context)
            throws Exception {

        switch (applicationName) {

            case "PP.COMPANY.PROPERTIES":

                validateDynamicRecords(
                        applicationName,
                        actualData,
                        "pp-company-properties-schema.json",
                        context);

                break;

            case "CURRENCY":

                validateDynamicRecords(
                        applicationName,
                        actualData,
                        "currency-schema.json",
                        context);

                break;

            case "PP.BANK.CONDITIONS":

                validateDynamicRecords(
                        applicationName,
                        actualData,
                        "pp-bank-conditions-schema.json",
                        context);

                break;

            default:

                context.addError(
                        new ValidationError(
                                applicationName,
                                "$.application",
                                "No schema defined for application",
                                applicationName));
        }
    }

    private void validateDynamicRecords(
            String applicationName,
            JsonNode rootNode,
            String schemaName,
            ValidationContext context)
            throws Exception {

        Iterator<String> fields =
                rootNode.fieldNames();

        while (fields.hasNext()) {

            String dynamicKey =
                    fields.next();

            JsonNode record =
                    rootNode.get(dynamicKey);

            validator.validate(
                    record,
                    schemaName,
                    applicationName,
                    context);
        }
    }
}





