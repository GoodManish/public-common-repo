  import java.io.FileWriter;
import java.time.LocalDateTime;
import java.util.List;

public class HtmlValidationReportGenerator {

    public void generate(
            List<ValidationError> errors,
            String outputFile)
            throws Exception {

        boolean success = errors.isEmpty();

        String status =
                success ? "SUCCESS" : "FAILED";

        String statusColor =
                success ? "green" : "red";

        StringBuilder html =
                new StringBuilder();

        html.append("""
            <html>
            <head>

            <title>YAML Validation Report</title>

            <style>

                body {
                    font-family: Arial;
                    margin: 20px;
                    background-color: #f4f4f4;
                }

                h1 {
                    color: #333;
                }

                .summary {
                    background: white;
                    padding: 15px;
                    border-radius: 5px;
                    margin-bottom: 20px;
                }

                table {
                    width: 100%;
                    border-collapse: collapse;
                    background: white;
                }

                th {
                    background-color: #333;
                    color: white;
                    padding: 12px;
                    text-align: left;
                }

                td {
                    padding: 10px;
                    border-bottom: 1px solid #ddd;
                }

                tr:nth-child(even) {
                    background-color: #f9f9f9;
                }

            </style>

            </head>
            <body>
            """);

        html.append("<h1>YAML Validation Report</h1>");

        html.append("<div class='summary'>");

        html.append("<p><b>Status:</b> ")
                .append("<span style='color:")
                .append(statusColor)
                .append("'>")
                .append(status)
                .append("</span></p>");

        html.append("<p><b>Total Errors:</b> ")
                .append(errors.size())
                .append("</p>");

        html.append("<p><b>Generated At:</b> ")
                .append(LocalDateTime.now())
                .append("</p>");

        html.append("</div>");

        if (!success) {

            html.append("""
                <table>

                <tr>
                    <th>Application</th>
                    <th>Path</th>
                    <th>Error</th>
                    <th>Invalid Value</th>
                </tr>
                """);

            for (ValidationError error : errors) {

                html.append("<tr>");

                html.append("<td>")
                        .append(error.getApplicationName())
                        .append("</td>");

                html.append("<td>")
                        .append(error.getPath())
                        .append("</td>");

                html.append("<td>")
                        .append(error.getMessage())
                        .append("</td>");

                html.append("<td>")
                        .append(error.getInvalidValue())
                        .append("</td>");

                html.append("</tr>");
            }

            html.append("</table>");
        }

        html.append("</body></html>");

        FileWriter writer =
                new FileWriter(outputFile);

        writer.write(html.toString());

        writer.close();
    }
}





