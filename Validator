STEP 12 — Main Runner
ValidationApplication.java
import com.fasterxml.jackson.databind.JsonNode;

import java.io.File;

public class ValidationApplication {

    public static void main(String[] args)
            throws Exception {

        File yamlFile =
                new File(
                        "korea-entity-configuration.yaml");

        JsonNode root =
                YamlLoader.load(yamlFile);

        ValidationContext context =
                new ValidationContext();

        RootYamlValidator validator =
                new RootYamlValidator();

        validator.validate(
                root,
                "root-schema.json",
                context);

        ApplicationSchemaRouter router =
                new ApplicationSchemaRouter();

        router.validateApplications(
                root,
                context);

        BusinessRuleValidator businessValidator =
                new BusinessRuleValidator();

        businessValidator.validate(
                root,
                context);

        /*
           FINAL DECISION POINT
         */

        if (context.hasErrors()) {

            System.out.println(
                    "\n========== VALIDATION ERRORS ==========");

            context.getErrors()
                   .forEach(System.out::println);

            throw new RuntimeException(
                    "\nValidation failed with "
                    + context.getErrors().size()
                    + " error(s)");
        }

        /*
           SAFE TO PROCEED
         */

        System.out.println(
                "\nYAML Validation Successful");

        generateJsonFiles(root);
    }

    private static void generateJsonFiles(
            JsonNode root) {

        System.out.println(
                "Generating JSON files...");
    }
}

