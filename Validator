STEP 10 — Application Schema Router

This is the most important layer.

ApplicationSchemaRouter.java
import com.fasterxml.jackson.databind.JsonNode;

import java.util.Iterator;

ApplicationSchemaRouter.java
public class ApplicationSchemaRouter {

    private final RootYamlValidator validator =
            new RootYamlValidator();

    public void validateApplications(
            JsonNode root,
            ValidationContext context)
            throws Exception {

        JsonNode entities =
                root.get("entities");

        for (JsonNode entity : entities) {

            JsonNode applications =
                    entity.get("applications");

            for (JsonNode appNode : applications) {

                try {

                    String applicationName =
                            appNode.get("application")
                                   .asText();

                    Iterator<String> fields =
                            appNode.fieldNames();

                    while (fields.hasNext()) {

                        String field =
                                fields.next();

                        if ("application"
                                .equals(field)) {

                            continue;
                        }

                        JsonNode actualData =
                                appNode.get(field);

                        validateByApplication(
                                applicationName,
                                actualData,
                                context);
                    }

                } catch (Exception ex) {

                    context.addError(
                            new ValidationError(
                                    "$.applications",
                                    ex.getMessage(),
                                    "APPLICATION_ERROR"));
                }
            }
        }
    }

    private void validateByApplication(
            String applicationName,
            JsonNode actualData,
            ValidationContext context)
            throws Exception {

        switch (applicationName) {

            case "PP.COMPANY.PROPERTIES":

                validator.validate(
                        actualData,
                        "pp-company-properties-schema.json",
                        context);

                break;

            case "CURRENCY":

                validateCurrencies(
                        actualData,
                        context);

                break;

            case "PP.BANK.CONDITIONS":

                validator.validate(
                        actualData,
                        "pp-bank-conditions-schema.json",
                        context);

                break;

            default:

                context.addError(
                        new ValidationError(
                                "$.application",
                                "No schema defined for application: "
                                        + applicationName,
                                applicationName));
        }
    }

    private void validateCurrencies(
            JsonNode currencyNode,
            ValidationContext context)
            throws Exception {

        Iterator<String> currencies =
                currencyNode.fieldNames();

        while (currencies.hasNext()) {

            String currency =
                    currencies.next();

            JsonNode currencyData =
                    currencyNode.get(currency);

            validator.validate(
                    currencyData,
                    "currency-schema.json",
                    context);
        }
    }
}

