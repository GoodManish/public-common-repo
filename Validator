STEP 11 — Business Validation Layer
BusinessRuleValidator.java
import com.fasterxml.jackson.databind.JsonNode;

public class BusinessRuleValidator {

    public void validate(
            JsonNode root,
            ValidationContext context) {

        JsonNode entities =
                root.get("entities");

        for (JsonNode entity : entities) {

            JsonNode applications =
                    entity.get("applications");

            for (JsonNode app : applications) {

                String appName =
                        app.get("application")
                           .asText();

                if ("PP.COMPANY.PROPERTIES"
                        .equals(appName)) {

                    validateCompanyRules(
                            app,
                            context);
                }
            }
        }
    }

    private void validateCompanyRules(
            JsonNode app,
            ValidationContext context) {

        JsonNode data =
                app.get("HKG-20211229");

        if (data == null) {
            return;
        }

        String homeCurrency =
                data.path("Home Currency Code")
                    .asText();

        String country =
                data.path("Homecountrycode")
                    .asText();

        if ("HK".equals(country)
                && !"HKD".equals(homeCurrency)) {

            context.addError(
                    new ValidationError(
                            "$.Home Currency Code",
                            "HK country must use HKD",
                            homeCurrency));
        }
    }
}

